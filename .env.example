# .env にコピーして編集してください。
# データベース: SQL Server の TONOPS-SCH（なければ create_schema / seed_demo が自動で作成）

# Windows 認証（ユーザー名なし = Trusted_Connection）。既定インスタンスの場合:
DATABASE_URL=mssql+pyodbc://@localhost/TONOPS-SCH?driver=ODBC+Driver+18+for+SQL+Server&TrustServerCertificate=yes

# SQL Server Express（名前付きインスタンス）の場合:
# DATABASE_URL=mssql+pyodbc://@localhost\SQLEXPRESS/TONOPS-SCH?driver=ODBC+Driver+18+for+SQL+Server&TrustServerCertificate=yes

# SQL Server 認証の場合:
# DATABASE_URL=mssql+pyodbc://USER:PASSWORD@localhost:1433/TONOPS-SCH?driver=ODBC+Driver+18+for+SQL+Server&TrustServerCertificate=yes

# ODBC Driver 17 しか入っていない場合は driver=ODBC+Driver+17+for+SQL+Server に変更

# API の呼び出しを許可するオリジン（カンマ区切り。Angular 開発サーバー）
CORS_ORIGINS=http://localhost:4200

# ソルバーワーカーのポーリング間隔（秒）
WORKER_POLL_SECONDS=2
