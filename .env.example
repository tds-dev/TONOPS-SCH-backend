# .env にコピーして編集してください。
# SQLite（ローカルでの手軽な起動。インストール不要）:
DATABASE_URL=sqlite:///./scheduler_dev.db

# SQL Server（ODBC Driver 18）の例:
# DATABASE_URL=mssql+pyodbc://USER:PASSWORD@localhost:1433/SCHEDULER?driver=ODBC+Driver+18+for+SQL+Server&TrustServerCertificate=yes

# API の呼び出しを許可するオリジン（カンマ区切り。Angular 開発サーバー）
CORS_ORIGINS=http://localhost:4200

# ソルバーワーカーのポーリング間隔（秒）
WORKER_POLL_SECONDS=2
