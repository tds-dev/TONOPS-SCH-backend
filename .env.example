# .env にコピーして編集してください。
# データベース: SQL Server の TONOPS-SCH（なければ create_schema / seed_demo が自動で作成）

# Windows 認証（ユーザー名なし = Trusted_Connection）。既定インスタンス・ODBC Driver 17 の場合:
DATABASE_URL=mssql+pyodbc://@localhost/TONOPS-SCH?driver=ODBC+Driver+17+for+SQL+Server

# SQL Server Express（名前付きインスタンス）の場合:
# DATABASE_URL=mssql+pyodbc://@localhost\SQLEXPRESS/TONOPS-SCH?driver=ODBC+Driver+17+for+SQL+Server

# SQL Server 認証の場合:
# DATABASE_URL=mssql+pyodbc://USER:PASSWORD@localhost:1433/TONOPS-SCH?driver=ODBC+Driver+17+for+SQL+Server

# ODBC Driver 18 を使う場合（暗号化が既定で必須のため TrustServerCertificate も付ける）:
# DATABASE_URL=mssql+pyodbc://@localhost/TONOPS-SCH?driver=ODBC+Driver+18+for+SQL+Server&TrustServerCertificate=yes
# インストール済みのドライバーは python -m scripts.create_database で表示されます（接続に失敗した場合）

# API の呼び出しを許可するオリジン（カンマ区切り。Angular 開発サーバー）
CORS_ORIGINS=http://localhost:4200

# ソルバーワーカーのポーリング間隔（秒）
WORKER_POLL_SECONDS=2
